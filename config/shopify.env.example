# Kopie als config/shopify.env speichern und ausfüllen (wird nicht hochgeladen)

# Zugangsdaten der App (Shopify Dev Dashboard -> App -> Einstellungen)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Ein Shop pro Marke: SHOP_<MARKE>=<adresse>.myshopify.com
# Der Name nach SHOP_ erscheint im Titel der Stockliste (Unterstrich = Leerzeichen).
# Bei mehreren Shops fragt das Programm beim Start, für welche Marke die Liste erstellt wird.
SHOP_RETERNITY=reternity.myshopify.com
# SHOP_ZWEITE_MARKE=zweite-marke.myshopify.com

# Nur falls ein Shop eine eigene App hat (sonst weglassen):
# SHOPIFY_CLIENT_ID_ZWEITE_MARKE=
# SHOPIFY_CLIENT_SECRET_ZWEITE_MARKE=
