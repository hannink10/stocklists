{
  "_info": "Bestätigtes Mapping CSV -> Excel-Stockliste. Änderungen siehe README.md.",

  "csv": {
    "_note": "Trennzeichen 'auto' = wird erkannt (; , Tab |). decimal = Dezimalzeichen, wenn nicht eindeutig.",
    "delimiter": "auto",
    "encodings": ["utf-8-sig", "cp1252"],
    "decimal": ","
  },

  "columns": {
    "_note": "Spalten werden über ihren Namen gefunden (Groß-/Kleinschreibung und Satzzeichen egal). Erst 'header', dann 'aliases' in dieser Reihenfolge. occurrence: welche Spalte, wenn der Name mehrfach vorkommt (nur bei unterschiedlichen Werten).",
    "sku":        {"header": "SKU", "aliases": ["Artikelnummer", "Art.-Nr.", "Art Nr", "ArtNr", "Artikelnr", "Item Number", "Item No", "Article Number", "Article No", "Product Code", "Style Number", "Variant SKU"]},
    "name":       {"header": "NAME", "aliases": ["Artikelname", "Bezeichnung", "Artikelbezeichnung", "Produktname", "Product Name", "Item Name", "Description", "Beschreibung", "Title", "Titel"]},
    "uvp":        {"header": "UVP", "aliases": ["RRP", "Retail Price", "Retail", "MSRP", "VK", "VK-Preis", "Verkaufspreis", "VK brutto", "Endkundenpreis", "Preis brutto"]},
    "unit_price": {"header": "UNIT PRICE", "occurrence": 2, "required": false, "_note": "fehlt die Spalte, wird nach dem Markup gefragt (EK = UVP ÷ Markup)", "aliases": ["Händlerpreis", "Haendlerpreis", "EK", "EK-Preis", "EK netto", "Einkaufspreis", "Wholesale", "Wholesale Price", "WHS", "B2B Price", "B2B-Preis", "Net Price", "Nettopreis", "Price"]},
    "discount":   {"header": "DISCOUNT", "required": false, "_note": "optional; wenn vorhanden: Spalten DISCOUNT und DISCOUNT PRICE in der Liste", "aliases": ["Discount %", "Discount in %", "Rabatt", "Rabatt %", "Rabatt in %", "Nachlass", "Nachlass %", "Reduction", "Sale %"]},
    "stock":      {"header": "AVAILABLE", "aliases": ["Bestand", "Lager", "Verfügbar", "Verfügbarer Bestand", "Lagerbestand", "Stock", "Available Stock", "Qty", "Quantity", "Menge", "Inventory", "On Hand"]}
  },

  "brands": {
    "_note": "Einstellungen je Marke (Name wie in config/shopify.env). columns: eigene Spaltennamen, z.B. {\"unit_price\": {\"header\": \"EK Händler\"}}. sku_rule: wie die Größe in der SKU steht – Standard ist Trennzeichen '-' (1032212-XS), 'patterns' = Liste von Mustern (reguläre Ausdrücke mit base und size).",
    "Reternity": {
      "product_groups": {
        "_note": "sku_prefixes: SKU-Anfang -> Kategorie, wird vor den Stichwörtern im Namen geprüft.",
        "sku_prefixes": [["40", "Shoes"]]
      }
    },
    "Flowers": {
      "product_groups": {
        "_note": "Schuhmodelle von Flowers heißen nicht 'Sneaker' – zusätzliche Stichwörter, geprüft nach den allgemeinen.",
        "order": ["Shoes", "Shirts", "Hoodies", "Knitwear", "Jackets", "Pants", "Accessories"],
        "rules": [["SEED", "Shoes"], ["OFFSHOOT", "Shoes"], ["SENSE", "Shoes"], ["BLEND", "Shoes"], ["RADICLE", "Shoes"],
                  ["AENERGY", "Shoes"], ["BLANC CANVAS", "Shoes"], ["THE OG", "Shoes"], ["HUGO", "Shoes"],
                  ["FORGET ME NOT", "Shoes"]]
      },
      "sku_rule": {
        "_note": "Der Reihe nach geprüft, das erste passende Muster mit bekannter Größe gewinnt. Sonst One-Size (mit Hinweis).",
        "mode": "patterns",
        "patterns": [
          "(?P<base>FFS\\d{3})(?P<size>\\d{2})",
          "(?P<base>.+)-(?P<size>[^-]+)",
          "(?P<base>.+_\\d)(?P<size>XXL|XL|L|M|S|XS)",
          {"_note": "Ältere Schuhe mit US-Größe: W = Damen, M = Herren, 55 = 5,5. Umrechnung wie im Flowers-Shopify; SKUs mit EU-Größe (W36, M41) werden direkt übernommen.", "pattern": "(?P<base>FFS\\d{3})(?P<size>[WM]\\d{1,3})", "size_map": {"W5": "36", "W55": "36.5", "W6": "37", "W65": "37.5", "W7": "38", "W75": "38.5", "W8": "39", "W85": "40", "W9": "40.5", "W95": "41", "W10": "42", "W105": "42.5", "W11": "43", "M7": "40", "M75": "40.5", "M8": "41", "M85": "42", "M9": "42.5", "M95": "43", "M10": "44", "M105": "44.5", "M11": "45", "M115": "46", "M12": "47", "M125": "47.5", "M13": "48", "W35": "35", "W36": "36", "W37": "37", "W38": "38", "W39": "39", "W40": "40", "W41": "41", "W42": "42", "W43": "43", "W44": "44", "W45": "45", "W46": "46", "W47": "47", "W48": "48", "M35": "35", "M36": "36", "M37": "37", "M38": "38", "M39": "39", "M40": "40", "M41": "41", "M42": "42", "M43": "43", "M44": "44", "M45": "45", "M46": "46", "M47": "47", "M48": "48"}}
        ]
      }
    }
  },

  "excel": {
    "header_row": 2,
    "first_data_row": 3,
    "column_headers": {
      "image": "Image",
      "sku": "SKU",
      "name": "Name",
      "unit_price": "UNIT PRICE",
      "uvp": "UVP",
      "quantity": "Quantity",
      "total": "TOTAL"
    },
    "date_placeholder": "xx.xx.",
    "date_format": "%d.%m.%Y",
    "default_brand": "Reternity",
    "title": "STOCK LIST {BRAND} - {date}",
    "sheet_name": "Stocklist {brand} {date}",
    "grand_total_label": "TOTAL",
    "_labels_note": "Texte in der Liste, die von der Vorlage abweichen sollen (Englisch). Leer lassen = Text aus der Vorlage.",
    "price_order": ["uvp", "unit_price"],
    "header_labels": {"uvp": "RRP", "discount": "DISCOUNT", "discount_price": "DISCOUNT PRICE"},
    "stock_row_labels": {"quantity": "Stock", "total": "per size"},
    "order_hints": {
      "_note": "Legende oben + Hinweis beim Klick in die orange Bestellzeile. limit_to_stock: mehr als der Bestand wird abgelehnt.",
      "enabled": true,
      "limit_to_stock": true,
      "legend_label": "HOW TO ORDER",
      "legend_stock": "AVAILABLE STOCK",
      "legend_order": "YOUR ORDER QTY",
      "prompt_title": "Your order",
      "prompt": "Enter the quantity you want to order for this size.",
      "error_title": "Not available",
      "error": "This quantity is higher than the available stock for this size (grey row above).",
      "error_none": "This size is not available."
    },
    "search": {
      "_note": "Suchfeld oben links: SKU oder Teil des Namens eintippen, Link springt zum ersten Treffer, alle Treffer werden gelb markiert.",
      "enabled": true,
      "label": "SEARCH",
      "prompt_title": "Search",
      "prompt": "Type a SKU or part of a product name, then click the link on the right.",
      "empty_hint": "← type SKU or name",
      "not_found": "No match",
      "jump": "→ Jump to"
    }
  },

  "sizes": {
    "sku_separator": "-",
    "no_size_column": "One-Size",
    "extra_sizes": [
      {"size": "S/M",  "insert_after": "XXL"},
      {"size": "L/XL", "insert_after": "S/M"},
      {"size": "35",   "insert_after": "34"},
      {"size": "36.5", "insert_after": "36"},
      {"size": "37",   "insert_after": "36.5"},
      {"size": "37.5", "insert_after": "37"},
      {"size": "38.5", "insert_after": "38"},
      {"size": "40.5", "insert_after": "40"},
      {"size": "42.5", "insert_after": "42"},
      {"size": "44.5", "insert_after": "44"},
      {"size": "47.5", "insert_after": "47"},
      {"size": "48",   "insert_after": "47.5"}
    ]
  },

  "rules": {
    "skip_articles_without_stock": true,
    "show_zero_stock": true,
    "sort": "bestseller",
    "order_formulas": true,
    "grand_total_row": true,
    "remove_unused_sizes": true,
    "landscape_print": false
  },

  "product_groups": {
    "_note": "Sortierung nach Produktgruppen. Gruppe kommt aus dem Artikelnamen: die erste passende Regel (von oben) gewinnt. Texte erscheinen so in der Liste (Englisch).",
    "enabled": true,
    "bestseller_top": 10,
    "bestseller_title": "BESTSELLER",
    "navigation": true,
    "navigation_label": "CONTENTS",
    "other_group": "Other",
    "ask_unknown": true,
    "_ask_unknown_note": "true = Artikel ohne Kategorie werden beim Start im Fenster abgefragt; die Antwort landet in config/category_overrides.json (je Marke und Modellname) und gilt ab dann immer.",
    "order": ["Hoodies", "Shirts", "Jackets", "Pants", "Knitwear", "Shoes", "Accessories"],
    "rules": [
      ["KNIT", "Knitwear"], ["SWEATER", "Knitwear"], ["JERSEY", "Knitwear"], ["POLO", "Knitwear"], ["CARDIGAN", "Knitwear"],
      ["BOXERSHORTS", "Accessories"], ["BOXER", "Accessories"], ["SOCKS", "Accessories"], ["FRAGRANCE", "Accessories"],
      ["SHORTS", "Pants"], ["JORTS", "Pants"],
      ["ZIP SHIRT", "Shirts"], ["OVERSHIRT", "Shirts"],
      ["HOODIE", "Hoodies"], ["HALF ZIP", "Hoodies"], ["ZIP JACKET", "Hoodies"], ["SWEATSHIRT", "Hoodies"], ["CREWNECK", "Hoodies"],
      ["JACKET", "Jackets"], ["PUFFER", "Jackets"], ["VEST", "Jackets"], ["BOMBER", "Jackets"], ["COAT", "Jackets"],
      ["SHIRT", "Shirts"], ["TSHIRT", "Shirts"], ["LONGSLEEVE", "Shirts"], ["TEE", "Shirts"], ["TANK TOP", "Shirts"], ["TOP", "Shirts"], ["FLANNEL", "Shirts"],
      ["PANTS", "Pants"], ["SWEATPANTS", "Pants"], ["JOGGER", "Pants"], ["DENIM", "Pants"], ["JEANS", "Pants"], ["CARGO", "Pants"], ["TROUSERS", "Pants"],
      ["SNEAKER", "Shoes"], ["SNEAKERS", "Shoes"], ["SHOE", "Shoes"], ["SHOES", "Shoes"], ["BOOT", "Shoes"], ["BOOTS", "Shoes"],
      ["LOAFER", "Shoes"], ["SLIDES", "Shoes"], ["SANDAL", "Shoes"], ["SANDALS", "Shoes"], ["MULE", "Shoes"], ["CLOG", "Shoes"],
      ["BEANIE", "Accessories"], ["CAP", "Accessories"], ["HAT", "Accessories"], ["BAG", "Accessories"], ["BELT", "Accessories"],
      ["SOCKS", "Accessories"], ["SCARF", "Accessories"], ["WALLET", "Accessories"],
      ["BACKPACK", "Accessories"], ["POUCH", "Accessories"], ["PINS", "Accessories"], ["KNIFE", "Accessories"]
    ]
  },

  "shopify": {
    "enabled": true,
    "api_version": "2025-10",
    "images": true,
    "match_by_name": true,
    "image_max_px": [110, 115],
    "image_cache_dir": "cache/images",
    "bestseller_days": 60
  },

  "paths": {
    "input_dir": "input",
    "archive_dir": "input/archiv",
    "template": "template/stocklist_template.xlsx",
    "output_dir": "output",
    "output_filename": "Stocklist_{brand}_{date_iso}.xlsx"
  }
}
